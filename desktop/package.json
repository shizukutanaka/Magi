{
  "name": "magi-desktop",
  "productName": "Magi",
  "version": "0.1.0",
  "private": true,
  "description": "自分で起動した Magi（self-host）を開くだけのデスクトップ用ランチャー",
  "license": "MIT",
  "author": "shizukutanaka",
  "homepage": "https://github.com/shizukutanaka/Magi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "44.11.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.shizukutanaka.magi.desktop",
    "productName": "Magi",
    "artifactName": "Magi-Desktop-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "policy.js",
      "launcher-page.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "zip",
      "category": "public.app-category.lifestyle",
      "identity": null
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
